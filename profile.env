#!/usr/bin/env bash
# ============================================================
# DSH Docker 环境变量配置
#
# 使用方式：
#   1. 容器内手动生效：   source /dsh/profile.env
#   2. 修改后永久生效：   编辑本文件后重启容器（entrypoint 会自动加载）
#   3. 单个覆盖：         可用 docker run -e <变量>=<值> 覆盖同名变量
#
# 对外端口（由 docker run 映射到容器 80/443）：
#   docker run -d --name dsh-web --hostname dsh-web -p 9080:80 -p 9443:443 <image>
# 注意：这两个变量仅用于容器启动时的访问地址提示，
#       实际监听端口由 docker run -p 决定，改这里不会改变端口映射。
# ============================================================

# 绿色安装根目录
export DSH_ROOT="${DSH_ROOT:-/dsh}"

# DSH 数据目录（profile、插件等）
export DSH_HOME="${DSH_HOME:-/dsh/home}"

# DSH Web UI 监听地址（Nginx 反向代理目标）
# 修改这两项后需同步调整 /dsh/config/nginx/conf.d/dsh-proxy.conf 的 proxy_pass
export DSH_WEB_HOST="${DSH_WEB_HOST:-127.0.0.1}"
export DSH_WEB_PORT="${DSH_WEB_PORT:-3080}"

# 外部 HTTP / HTTPS 端口（仅用于启动时的访问地址提示，实际以 docker run -p 映射为准）
export DSH_HTTP_PORT="${DSH_HTTP_PORT:-9080}"
export DSH_HTTPS_PORT="${DSH_HTTPS_PORT:-9443}"

# ------------------------------------------------------------
# 启动与看护参数
# ------------------------------------------------------------

# 就绪等待的「软上限」（秒）
# DSH 首次启动要初始化插件，耗时不定（通常 10~40s，装了数据分析插件可能 1~3 分钟）。
# 判据是**事件**而非时长：只要进程还活着就继续等，本值仅控制提示频率 ——
# 在此秒数内每 10s 打一次进度；超过后改为每 30s 打一次并附日志尾部。
# **不会因为超过本值而判失败。**
export DSH_READY_TIMEOUT="${DSH_READY_TIMEOUT:-120}"

# 就绪等待的「硬上限」（秒）
# 0 = 不限（推荐）：一直等到就绪或进程退出。
# 若设为正数（如 600），超过该秒数仍未就绪则放弃启动。
# 仅适用于不允许容器长时间处于启动态的编排场景。
export DSH_READY_HARD_TIMEOUT="${DSH_READY_HARD_TIMEOUT:-0}"

# 服务不可达的容忍窗口（秒）
# dshctl 执行计划内重启时，DSH 会换 PID 并有一段交接期（relaunch 最长约 45s）。
# 连续不可达超过本值才会判定为真故障并让容器退出。
export DSH_DOWN_GRACE="${DSH_DOWN_GRACE:-90}"

# 时区（默认北京时间）
# 修改后需重启容器生效；也可用 docker run -e TZ=Asia/Tokyo 临时覆盖。
# 注意：/etc/localtime 已在镜像构建时固化为该值，
#       若在此处改成其他时区，entrypoint 会自动同步 /etc/localtime。
export TZ="${TZ:-Asia/Shanghai}"
# 校验 TZ 合法性：无效值会让 date/nginx 显示字面量而非时间，
# 这里直接回退到 Asia/Shanghai（改完 TZ 后需同步重设，故放在其后）。
if [ ! -f "/usr/share/zoneinfo/${TZ}" ]; then
    echo "  警告：时区 ${TZ} 在 /usr/share/zoneinfo 中不存在，回退为 Asia/Shanghai"
    export TZ="Asia/Shanghai"
fi

# 字符编码（locale）
# 镜像已设 ENV LANG/LC_ALL=C.UTF-8，这里再兜底一次：
# 若使用 docker run -e LC_ALL=... 覆盖、或该值被清空，会让 less/grep
# 退回 POSIX/C locale —— 那时查看含中文的脚本会报 "may be a binary file"
# 并把中文显示成 <E5><8A><A0> 之类的逐字节转义。
# C.UTF-8 由 glibc 内置（Debian 自带，无需 locale-gen），故用它兜底。
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"

# PATH：优先使用绿色安装的 nodejs / python bin
# python 路径仅在镜像包含 Python 时加入（Python 由构建参数 PYTHON_MODE
# 控制，默认 apt 装发行版自带版本；none 模式下 /dsh/app/python 不存在，
# 且依赖 Python 的插件将无法加载）
DSH_PATH="${DSH_ROOT}/app/nodejs/bin"
if [ -x "${DSH_ROOT}/app/python/bin/python3" ]; then
    DSH_PATH="${DSH_PATH}:${DSH_ROOT}/app/python/bin:${DSH_ROOT}/app/python/venv/bin"
fi
export PATH="${DSH_PATH}:${PATH}"

# 插件 Python 定位（与 entrypoint.sh 保持一致，供交互式 shell / 子进程使用）
# 内置插件 dsh-data-analysis 通过 BOOTSTRAP 变量找到"引导解释器"，
# 再用它创建自己的托管 venv。这里**只设 BOOTSTRAP**，
# 不设 DSH_DATA_ANALYSIS_PYTHON —— 原因见 entrypoint.sh 注释。
if [ -x "${DSH_ROOT}/app/python/bin/python3" ]; then
    export DSH_DATA_ANALYSIS_BOOTSTRAP_PYTHON="${DSH_DATA_ANALYSIS_BOOTSTRAP_PYTHON:-${DSH_ROOT}/app/python/bin/python3}"
fi

# ------------------------------------------------------------
# 插件开关
# ------------------------------------------------------------

# 数据分析插件（@chengxianglibra/dsh-data-analysis，Marivo 语义分析）
# 该插件依赖本地 Python 与 pip 拉取 marivo，体量大、首次装包耗时长；
# 不需要自然语言分析 / 图表 / 看板时保持关闭，可显著缩短首次启动时间。
#
# 默认为「不设置」—— 此时以 config/dsh/versions.yml 中该插件的
# enabled 值为准（当前为 false，即不装），保持单一数据源。
# 若在此强行 export 成 false，会永久覆盖 yml 的设定；确需固定行为时再取消注释。
# export DSH_ENABLE_DATA_ANALYSIS="false"

# 临时启用（不改 yml，本次启动及后续重启均生效）：
#   docker run -e DSH_ENABLE_DATA_ANALYSIS=true ...
# 或取消下面这行注释：
# export DSH_ENABLE_DATA_ANALYSIS="true"

# 内部路径（一般无需修改）
export DSH_LOG_DIR="${DSH_ROOT}/log/dsh"export NGINX_LOG_DIR="${DSH_ROOT}/log/nginx"
export RUN_DIR="${DSH_ROOT}/run"
export SSL_DIR="${DSH_ROOT}/config/nginx/ssl"
export DSH_LOG="${DSH_LOG_DIR}/dsh-web.log"