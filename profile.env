#!/usr/bin/env bash
# ============================================================
# DSH Docker 环境变量配置
#
# 使用方式：
#   1. 容器内手动生效：   source /dsh/profile.env
#   2. 修改后永久生效：   编辑本文件后重启容器（entrypoint 会自动加载）
#   3. 单个覆盖：         可用 docker run -e <变量>=<值> 覆盖同名变量
#
# 对外端口（由 docker run 映射到容器 80/443）：
#   docker run -d --name dsh-web --hostname dsh-web -p 9080:80 -p 9443:443 <image>
# 注意：这两个变量仅用于容器启动时的访问地址提示，
#       实际监听端口由 docker run -p 决定，改这里不会改变端口映射。
# ============================================================

# 绿色安装根目录
export DSH_ROOT="${DSH_ROOT:-/dsh}"

# DSH 数据目录（profile、插件等）
export DSH_HOME="${DSH_HOME:-/dsh/home}"

# DSH Web UI 监听地址（Nginx 反向代理目标）
# 修改这两项后需同步调整 /dsh/config/nginx/conf.d/dsh-proxy.conf 的 proxy_pass
export DSH_WEB_HOST="${DSH_WEB_HOST:-127.0.0.1}"
export DSH_WEB_PORT="${DSH_WEB_PORT:-3080}"

# 外部 HTTP / HTTPS 端口（仅用于启动时的访问地址提示，实际以 docker run -p 映射为准）
export DSH_HTTP_PORT="${DSH_HTTP_PORT:-9080}"
export DSH_HTTPS_PORT="${DSH_HTTPS_PORT:-9443}"

# PATH：优先使用绿色安装的 nodejs / python bin
export PATH="${DSH_ROOT}/app/nodejs/bin:${DSH_ROOT}/app/python/bin:${DSH_ROOT}/app/python/venv/bin:${PATH}"

# 内部路径（一般无需修改）
export DSH_LOG_DIR="${DSH_ROOT}/log/dsh"
export NGINX_LOG_DIR="${DSH_ROOT}/log/nginx"
export RUN_DIR="${DSH_ROOT}/run"
export SSL_DIR="${DSH_ROOT}/config/nginx/ssl"
export DSH_LOG="${DSH_LOG_DIR}/dsh-web.log"